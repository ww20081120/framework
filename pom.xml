			<!-- 做checkstyle的插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${checkstyle.version}</version>
				<configuration>
					<configLocation>config/checkstyle/hbasesoft-check-1.0.xml</configLocation>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle</id>
						<phase>deploy</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<failOnViolation>true</failOnViolation>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- PMD代码质量检查插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${pmd.version}</version>
				<configuration>
					<minimumTokens>100</minimumTokens>
					<targetJdk>${java.version}</targetJdk>
					<excludes>
						<!-- 排除生成的代码 -->
						<exclude>**/generated/**</exclude>
						<exclude>**/generated-sources/**</exclude>
						<!-- 排除测试代码（可选） -->
						<exclude>**/test/**</exclude>
					</excludes>
					<excludeRoots>
						<excludeRoot>target/generated-sources/stubs</excludeRoot>
					</excludeRoots>
					<!-- 使用自定义规则集 - 使用项目根目录的绝对路径 -->
					<rulesets>
						<ruleset>
							${maven.multiModuleProjectDirectory}/config/pmd/pmd-rules.xml</ruleset>
					</rulesets>
					<!-- 编码 -->
					<sourceEncoding>UTF-8</sourceEncoding>
					<!-- 1-2级错误阻断构建，3-5级仅报告 -->
					<failOnViolation>true</failOnViolation>
					<!-- 优先级阈值：1-2级阻断，3-5级不阻断 -->
					<minimumPriority>2</minimumPriority>
					<!-- 排除级别文件（可选） -->
					<excludeFromFailureFile>
						${maven.multiModuleProjectDirectory}/config/pmd/pmd-exclude.properties</excludeFromFailureFile>
				</configuration>
				<executions>
					<execution>
						<id>pmd</id>
						<phase>deploy</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- SpotBugs代码质量检查插件 -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-maven-plugin.version}</version>
				<configuration>
