						<artifactId>spotbugs</artifactId>
						<version>${spotbugs.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>spotbugs</id>
						<phase>deploy</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- 在编译时自动安装git hooks的插件 -->
			<plugin>
				<groupId>io.github.phillipuniverse</groupId>
				<artifactId>githook-maven-plugin</artifactId>
				<version>${githook.version}</version>
				<executions>
					<execution>
						<!-- 绑定到initialize阶段，确保在编译前就安装hooks -->
						<phase>initialize</phase>
						<goals>
							<goal>install</goal>
						</goals>
						<configuration>
							<hooks>
								<!--
								注意这里是调用shell命令去执行mvn命令，默认生成的hook文件执行路径可能与项目的pom.xml文件不一致，所以我这里用`-f`重新指定了本项目的pom文件路径 -->
								<pre-commit>
									# 代码质量检查开关（从 pom.xml 读取并替换）
									CODE_QUALITY_CHECKS_ENABLED="${code.quality.checks.enabled}"

									if [ "$CODE_QUALITY_CHECKS_ENABLED" != "true" ]; then
										echo "⚠️  代码质量检查已禁用 (code.quality.checks.enabled=$CODE_QUALITY_CHECKS_ENABLED)"
										echo "💡 如需启用检查，请在 pom.xml 中设置 code.quality.checks.enabled=true"
										exit 0
									fi

									# 动态获取项目根目录
									GIT_ROOT=$(git rev-parse --show-toplevel)
									PROJECT_ROOT="${GIT_ROOT}"

									# 引用外部脚本文件，避免 XML 格式化破坏 shell 脚本
									# 脚本文件位于 config/githooks/pre-commit.sh
									PRE_COMMIT_SCRIPT="${PROJECT_ROOT}/config/githooks/pre-commit.sh"

									if [ -f "$PRE_COMMIT_SCRIPT" ]; then
										bash "$PRE_COMMIT_SCRIPT"
									else
										# 如果脚本不存在，直接运行 checkstyle 检查
										echo "🔍 运行代码质量检查..."
										cd "$PROJECT_ROOT" || exit 1
										mvn checkstyle:check -q

										if [ $? -ne 0 ]; then
											echo "❌ 代码质量检查失败，请修复后再提交"
											exit 1
										fi

										echo "✅ 代码质量检查通过"
									fi
								</pre-commit>
							</hooks>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- 编译设置jdk版本的插件 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
		</plugins>

		<resources>
