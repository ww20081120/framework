<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      SpotBugs 排除规则配置
      根据项目实际情况调整需要忽略的检查项
    -->

    <!-- 忽略 Lombok 生成的代码相关问题 -->
    <Match>
        <Class name="~.*\$_*.*" />
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED" />
    </Match>

    <!-- 忽略测试代码中的某些问题 -->
    <Match>
        <Class name="~.*\.Test.*" />
        <Bug pattern="OS_OPEN_STREAM" />
    </Match>

    <Match>
        <Class name="~.*\.Test.*" />
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION" />
    </Match>

    <!-- 忽略序列化相关的警告（如果项目不需要） -->
    <!--
    <Match>
        <Bug pattern="SE_BAD_FIELD" />
    </Match>
    -->

    <!-- 忽略未使用的私有方法（可能在反射中被调用） -->
    <!--
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD" />
    </Match>
    -->

    <!-- 忽略性能相关的建议（可根据实际需要启用） -->
    <!--
    <Match>
        <Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION_IN_LOOPS" />
    </Match>
    -->
</FindBugsFilter>
